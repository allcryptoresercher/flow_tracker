# Скопируйте в .env и заполните на сервере. Файл .env в git не коммитится.

BOT_TOKEN=
ALLOWED_CHAT_ID=

# Необязательно. Пустые ключи оставляют кнопку Pushover выключенной.
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=

# Часовой пояс отметок времени в сообщениях
TZ=Europe/Vienna

# Имена и пароль должны совпадать с DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@postgres:5432/DBNAME
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
CONFIG_PATH=config.yaml
